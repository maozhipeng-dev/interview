# Server
SERVER_PORT=8080

# Spring Profile
SPRING_PROFILES_ACTIVE=h2

# Database Configuration
DB_URL=jdbc:h2:mem:interviewdb
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# MySQL Configuration (if using mysql profile)
# DB_URL=jdbc:mysql://localhost:3306/interview_db?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=your_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Logging
LOG_LEVEL=INFO

# H2 Console
H2_CONSOLE_ENABLED=true
